---
import Base from '../layouts/Base.astro';
import SpineWall from '../components/SpineWall.astro';
import data from '../data/books.json';

// Kill switch for the spines view — set false and the page builds exactly as it
// did before the Spine Wall existed (see docs/SPINE-WALL-SPEC.md).
const SPINE_WALL = true;

const books = [...data.books].sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));
const pagesRead = books.reduce((sum, b) => sum + (b.pages ?? 0), 0);
const fiveStars = books.filter((b) => b.rating === 5).length;
const types = [...new Set(books.map((b) => b.type).filter(Boolean))];

// Deterministic hue per title for books without a cover image.
const hue = (title) => {
  let n = 0;
  for (const c of title) n = (n * 31 + c.charCodeAt(0)) % 360;
  return n;
};
const year = (d) => (d ? d.slice(0, 4) : '');
---
<Base title="Bookshelf — Stephen Longo" description="Every book on the shelf, rated and shelved in Notion.">
  <header class="top">
    <a class="mono back" href="/">← Stephen Longo</a>
    <span class="mono">Index — 001 / Bookshelf</span>
  </header>

  <main>
    <section class="head">
      <h1>Book<em>shelf</em></h1>
      <p class="stats mono">
        {books.length} books · {pagesRead.toLocaleString()} pages · {fiveStars} five-stars · synced {data.syncedAt}
      </p>
    </section>

    <nav class="filters" aria-label="Filter books">
      {SPINE_WALL && (
        <>
          <button class="chip mono view-chip active" data-view="spines">Spines</button>
          <button class="chip mono view-chip" data-view="covers">Covers</button>
          <span class="view-divider" aria-hidden="true"></span>
        </>
      )}
      <button class="chip mono active" data-filter="all">All</button>
      <button class="chip mono" data-filter="five">★★★★★</button>
      <button class="chip mono" data-filter="recommend">Recommended</button>
      {types.map((t) => <button class="chip mono" data-filter={`type:${t}`}>{t}</button>)}
    </nav>

    {/* Spines are the default view, so the grid starts hidden — but only while
        the flag is on, so SPINE_WALL=false still builds the pre-feature page. */}
    <section class:list={['grid', { 'view-hide': SPINE_WALL }]}>
      {books.map((b) => (
        <article
          class="book"
          data-rating={b.rating ?? ''}
          data-type={b.type ?? ''}
          data-recommend={b.recommend ? '1' : ''}
        >
          <div class="jacket" style={`--hue:${hue(b.title)}`}>
            {b.cover ? (
              <img src={b.cover} alt={`Cover of ${b.title}`} loading="lazy" />
            ) : (
              <div class="spine">
                <span class="spine-title">{b.title}</span>
                {b.author && <span class="spine-author mono">{b.author}</span>}
              </div>
            )}
            <div class="overlay">
              {b.rating && <span class="rating">{'★'.repeat(b.rating)}<span class="off">{'★'.repeat(5 - b.rating)}</span></span>}
              {(b.takeaway || b.tagline) && <p class="note">“{b.takeaway || b.tagline}”</p>}
              {b.recommend && <span class="rec mono">Recommended</span>}
              {b.misogi && b.date && <a class="mis mono" href={`/misogi#y${year(b.date)}`}>Misogi ’{b.date.slice(2, 4)} →</a>}
            </div>
          </div>
          <h2 class="title">{b.title}</h2>
          <p class="meta mono">
            {b.author || 'Unknown'}{year(b.date) && ` · ${year(b.date)}`}{b.status === 'Reading' && ' · now reading'}
          </p>
        </article>
      ))}
    </section>

    {SPINE_WALL && <SpineWall books={books} />}
  </main>

  <footer class="bottom">
    <span class="mono">Shelved in Notion · rendered here</span>
    <span class="mono">© 2026</span>
  </footer>
</Base>

<style>
  .top,
  .bottom {
    display: flex;
    justify-content: space-between;
    padding: 1.4rem var(--pad-x);
  }

  .top {
    border-bottom: 1px solid var(--hairline);
  }

  .bottom {
    border-top: 1px solid var(--hairline);
  }

  .back {
    text-decoration: none;
    color: var(--ink);
  }

  .back:hover {
    color: var(--accent);
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--pad-x);
  }

  .head {
    padding: 5rem 0 2rem;
  }

  h1 {
    font-size: clamp(3.4rem, 11vw, 8.5rem);
    font-weight: 560;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  h1 em {
    font-style: italic;
    font-weight: 380;
    color: var(--accent);
  }

  .stats {
    margin-top: 1.4rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 1.5rem 0 2.5rem;
  }

  .chip {
    background: none;
    border: 1px solid var(--hairline);
    color: var(--dim);
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .chip:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .chip.active {
    background: var(--ink);
    border-color: var(--ink);
    color: #000;
  }

  .view-divider {
    width: 1px;
    align-self: stretch;
    background: var(--hairline);
    margin: 0 0.55rem;
  }

  .grid.view-hide {
    display: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(128px, 1fr));
    gap: 1.7rem 1.1rem;
    padding-bottom: 8rem;
  }

  .book.hide {
    display: none;
  }

  .jacket {
    position: relative;
    aspect-ratio: 2 / 3;
    border-radius: 3px;
    overflow: hidden;
    background: #141416;
    transition: transform 0.22s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .book:hover .jacket {
    transform: translateY(-6px);
  }

  .jacket img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .spine {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.85rem;
    background:
      linear-gradient(160deg, hsl(var(--hue) 32% 16%), hsl(var(--hue) 40% 8%));
    border: 1px solid hsl(var(--hue) 30% 24% / 0.6);
    border-radius: 3px;
  }

  .spine-title {
    font-size: 1rem;
    font-style: italic;
    font-weight: 480;
    line-height: 1.15;
  }

  .spine-author {
    font-size: 0.6rem;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(8, 8, 9, 0.88);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.85rem;
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .book:hover .overlay,
  .book:focus-within .overlay,
  .book.open .overlay {
    opacity: 1;
  }

  .book.open .jacket {
    transform: translateY(-6px);
  }

  .rating {
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .rating .off {
    color: var(--hairline);
  }

  .note {
    font-style: italic;
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--ink);
  }

  .rec {
    color: var(--accent);
  }

  .mis {
    color: var(--accent);
    text-decoration: none;
  }

  .mis:hover {
    text-decoration: underline;
  }

  .title {
    font-size: 0.9rem;
    font-weight: 480;
    margin-top: 0.65rem;
    line-height: 1.2;
  }

  .meta {
    margin-top: 0.3rem;
    font-size: 0.6rem;
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.2rem 0.7rem;
    }

    .spine-title {
      font-size: 0.85rem;
    }

    .title {
      font-size: 0.78rem;
    }

    .meta {
      font-size: 0.58rem;
    }
  }
</style>

<script is:inline>
  const chips = document.querySelectorAll('.chip[data-filter]');
  const books = document.querySelectorAll('.book');
  const spines = document.querySelectorAll('#spine-wall .sp');

  // No hover on touch screens — tap a book to reveal its rating and takeaway.
  if (matchMedia('(hover: none)').matches) {
    books.forEach((b) => {
      b.addEventListener('click', () => {
        const wasOpen = b.classList.contains('open');
        books.forEach((x) => x.classList.remove('open'));
        if (!wasOpen) b.classList.add('open');
      });
    });
  }
  // Filters combine: types OR together (Fiction + Biography = either), and
  // ★★★★★ / Recommended AND with them (★★★★★ + Fiction = five-star fiction).
  // "All" clears the selection and re-lights itself when nothing is active.
  const sel = { five: false, recommend: false, types: new Set() };
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      if (f === 'all') {
        sel.five = false;
        sel.recommend = false;
        sel.types.clear();
      } else if (f === 'five') {
        sel.five = !sel.five;
      } else if (f === 'recommend') {
        sel.recommend = !sel.recommend;
      } else {
        const t = f.slice(5);
        sel.types.has(t) ? sel.types.delete(t) : sel.types.add(t);
      }
      const empty = !sel.five && !sel.recommend && sel.types.size === 0;
      chips.forEach((c) => {
        const cf = c.dataset.filter;
        c.classList.toggle(
          'active',
          cf === 'all' ? empty
          : cf === 'five' ? sel.five
          : cf === 'recommend' ? sel.recommend
          : sel.types.has(cf.slice(5)),
        );
      });
      const matches = (el) =>
        (!sel.five || el.dataset.rating === '5') &&
        (!sel.recommend || el.dataset.recommend === '1') &&
        (sel.types.size === 0 || sel.types.has(el.dataset.type));
      books.forEach((b) => b.classList.toggle('hide', !matches(b)));
      // On the shelf, non-matches dim instead of hiding so it keeps its shape.
      spines.forEach((s) => s.classList.toggle('dim', !matches(s)));
    });
  });

  const wall = document.getElementById('spine-wall');
  if (wall) {
    const grid = document.querySelector('.grid');
    const viewChips = document.querySelectorAll('.view-chip');
    const setView = (v) => {
      viewChips.forEach((c) => c.classList.toggle('active', c.dataset.view === v));
      grid.classList.toggle('view-hide', v === 'spines');
      wall.classList.toggle('active', v === 'spines');
      try {
        localStorage.setItem('bookshelf-view', v);
      } catch {}
    };
    viewChips.forEach((c) => c.addEventListener('click', () => setView(c.dataset.view)));
    // Spines are the server-rendered default; only a stored covers preference flips it.
    try {
      if (localStorage.getItem('bookshelf-view') === 'covers') setView('covers');
    } catch {}
  }
</script>
