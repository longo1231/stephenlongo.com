---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import data from '../data/books.json';

const bookCount = data.books.length;
const fiveStars = data.books.filter((b) => b.rating === 5).length;
const musingsCount = (await getCollection('musings')).length;
---
<Base title="Stephen Longo" description="The basis of optimism is sheer terror.">
  <canvas id="stars" aria-hidden="true"></canvas>

  <header class="top">
    <span class="mono">Stephen Longo</span>
    <span class="mono">Index — 001</span>
  </header>

  <main>
    <section class="hero">
      <h1 class="quote" aria-label="The basis of optimism is sheer terror. Oscar Wilde.">
        <span class="line"><span class="w" style="--i:0">The</span> <span class="w" style="--i:1">basis</span> <span class="w" style="--i:2">of</span></span>
        <span class="line big"><span class="w" style="--i:3">optimism</span></span>
        <span class="line"><span class="w" style="--i:4">is</span> <span class="w" style="--i:5">sheer</span> <span class="w terror" style="--i:6">terror.</span></span>
      </h1>
      <p class="cite mono">— Oscar Wilde</p>
    </section>

    <nav class="index" aria-label="Site index">
      <a class="row" href="/bookshelf">
        <span class="num mono">001</span>
        <span class="name">Bookshelf</span>
        <span class="desc mono">{bookCount} books · {fiveStars} five-stars</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <a class="row" href="/musings">
        <span class="num mono">002</span>
        <span class="name">Musings</span>
        <span class="desc mono">{musingsCount} {musingsCount === 1 ? 'entry' : 'entries'} · unofficial thoughts</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <a class="row" href="https://stephenlongo.substack.com" target="_blank" rel="noopener">
        <span class="num mono">003</span>
        <span class="name">Area Under the Curve</span>
        <span class="desc mono">the newsletter, on Substack</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
      <a class="row" href="/reviews">
        <span class="num mono">004</span>
        <span class="name">Annual Reviews</span>
        <span class="desc mono">the matrices, by year</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </nav>
  </main>

  <footer class="bottom">
    <span class="mono">Content lives in Notion · the site rebuilds itself</span>
    <span class="mono">© 2026</span>
  </footer>
</Base>

<style>
  #stars {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.55;
  }

  .top,
  .bottom,
  main {
    position: relative;
    z-index: 1;
  }

  .top {
    display: flex;
    justify-content: space-between;
    padding: 1.4rem var(--pad-x);
    border-bottom: 1px solid var(--hairline);
  }

  .top .mono:first-child {
    color: var(--ink);
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--pad-x);
  }

  .hero {
    min-height: 62vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 0 3rem;
  }

  .quote {
    font-weight: 380;
    font-size: clamp(2.2rem, 6vw, 4.6rem);
    line-height: 1.04;
    letter-spacing: -0.015em;
  }

  .quote .line {
    display: block;
  }

  .quote .big {
    font-size: clamp(4rem, 13vw, 10.5rem);
    font-style: italic;
    font-weight: 640;
    font-variation-settings: 'opsz' 144;
    margin: 0.5rem 0;
  }

  .terror {
    color: var(--accent);
  }

  .w {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.45em);
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    animation-delay: calc(var(--i) * 0.09s + 0.15s);
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .cite {
    margin-top: 2rem;
    opacity: 0;
    animation: rise 0.7s ease forwards;
    animation-delay: 0.95s;
  }

  .index {
    display: block;
    border-top: 1px solid var(--hairline);
    margin-bottom: 14vh;
  }

  .row {
    display: grid;
    grid-template-columns: 4rem 1fr auto 3rem;
    align-items: baseline;
    gap: 1.5rem;
    padding: 2rem 0.5rem;
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .name {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 460;
    font-style: italic;
  }

  .arrow {
    font-size: 1.6rem;
    justify-self: end;
    transition: transform 0.18s ease;
  }

  .row:hover {
    background: var(--accent);
    color: #000;
  }

  .row:hover .mono {
    color: #000;
  }

  .row:hover .arrow {
    transform: translate(0.2rem, -0.2rem);
  }

  .bottom {
    display: flex;
    justify-content: space-between;
    padding: 1.4rem var(--pad-x);
    border-top: 1px solid var(--hairline);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 3rem 1fr 2rem;
    }
    .desc {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .w,
    .cite {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script is:inline>
  // Slow-drifting starfield; a quiet nod to Star Maker.
  const canvas = document.getElementById('stars');
  const ctx = canvas.getContext('2d');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let w, h, stars;

  function init() {
    w = canvas.width = innerWidth * devicePixelRatio;
    h = canvas.height = innerHeight * devicePixelRatio;
    const n = Math.floor((innerWidth * innerHeight) / 9000);
    stars = Array.from({ length: n }, () => ({
      x: Math.random() * w,
      y: Math.random() * h,
      r: (Math.random() * 1.1 + 0.3) * devicePixelRatio,
      v: Math.random() * 0.06 + 0.015,
      a: Math.random() * 0.5 + 0.15,
    }));
  }

  function frame() {
    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = '#e8e4dc';
    for (const s of stars) {
      ctx.globalAlpha = s.a;
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fill();
      s.y -= s.v * devicePixelRatio;
      if (s.y < -2) {
        s.y = h + 2;
        s.x = Math.random() * w;
      }
    }
    if (!reduced) requestAnimationFrame(frame);
  }

  init();
  frame();
  addEventListener('resize', () => {
    init();
    if (reduced) frame();
  });
</script>
