---
import Base from '../layouts/Base.astro';

const reviews = [
  {
    year: '2025',
    title: '2025 Matrix',
    desc: 'outcome vs. change in focus for 2026',
    href: '/reviews/2025-matrix/',
  },
  {
    year: '2024',
    title: '2024 Matrix',
    desc: 'outcome vs. change in focus for 2025',
    href: '/reviews/2024-matrix/',
  },
];
---
<Base title="Annual Reviews — Stephen Longo" description="Yearly matrix reviews: what worked, what gets more focus.">
  <header class="top">
    <a class="mono back" href="/">← Stephen Longo</a>
    <span class="mono">Index — 004 / Annual Reviews</span>
  </header>

  <main>
    <section class="head">
      <h1>Annual <em>Reviews</em></h1>
      <p class="stats mono">one matrix per year · outcome × focus</p>
    </section>

    <section class="list">
      {reviews.map((r) => (
        <a class="entry" href={r.href}>
          <span class="date mono">{r.year}</span>
          <span class="name">{r.title}</span>
          <span class="desc mono">{r.desc}</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </section>
  </main>

  <footer class="bottom">
    <span class="mono">A year, reviewed</span>
    <span class="mono">© 2026</span>
  </footer>
</Base>

<style>
  .top,
  .bottom {
    display: flex;
    justify-content: space-between;
    padding: 1.4rem 2rem;
  }

  .top {
    border-bottom: 1px solid var(--hairline);
  }

  .bottom {
    border-top: 1px solid var(--hairline);
  }

  .back {
    text-decoration: none;
    color: var(--ink);
  }

  .back:hover {
    color: var(--accent);
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    min-height: 60vh;
  }

  .head {
    padding: 5rem 0 2rem;
  }

  h1 {
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 560;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  h1 em {
    font-style: italic;
    font-weight: 380;
    color: var(--accent);
  }

  .stats {
    margin-top: 1.4rem;
  }

  .list {
    border-top: 1px solid var(--hairline);
    margin: 2.5rem 0 8rem;
  }

  .entry {
    display: grid;
    grid-template-columns: 6rem 1fr auto 3rem;
    align-items: baseline;
    gap: 1.5rem;
    padding: 2rem 0.5rem;
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .name {
    font-size: clamp(1.6rem, 3.5vw, 2.6rem);
    font-style: italic;
    font-weight: 440;
  }

  .arrow {
    justify-self: end;
    font-size: 1.4rem;
    transition: transform 0.18s ease;
  }

  .entry:hover {
    background: var(--accent);
    color: #000;
  }

  .entry:hover .mono {
    color: #000;
  }

  .entry:hover .arrow {
    transform: translate(0.2rem, -0.2rem);
  }

  @media (max-width: 640px) {
    .entry {
      grid-template-columns: 4rem 1fr 2rem;
    }
    .desc {
      display: none;
    }
  }
</style>
