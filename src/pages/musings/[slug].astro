---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('musings');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---
<Base title={`${post.data.title} — Stephen Longo`} description={post.data.title}>
  <header class="top">
    <a class="mono back" href="/musings">← Musings</a>
    <span class="mono">{fmt}</span>
  </header>

  <main>
    <article>
      <h1>{post.data.title}</h1>
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>

  <footer class="bottom">
    <span class="mono">Written in Notion · rendered here</span>
    <span class="mono">© 2026</span>
  </footer>
</Base>

<style>
  .top,
  .bottom {
    display: flex;
    justify-content: space-between;
    padding: 1.4rem var(--pad-x);
  }

  .top {
    border-bottom: 1px solid var(--hairline);
  }

  .bottom {
    border-top: 1px solid var(--hairline);
  }

  .back {
    text-decoration: none;
    color: var(--ink);
  }

  .back:hover {
    color: var(--accent);
  }

  main {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 var(--pad-x);
    min-height: 60vh;
  }

  article {
    padding: 5rem 0 8rem;
  }

  h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 560;
    font-style: italic;
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin-bottom: 2.5rem;
  }

  .prose {
    font-size: 1.16rem;
    font-weight: 360;
    line-height: 1.65;
    color: var(--ink);
  }

  .prose :global(p) {
    margin-bottom: 1.3em;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    font-weight: 560;
    margin: 2em 0 0.8em;
  }

  .prose :global(h3) {
    font-size: 1.2rem;
    font-weight: 560;
    margin: 1.6em 0 0.6em;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.3em 1.4em;
  }

  .prose :global(li) {
    margin-bottom: 0.4em;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 1.2rem;
    font-style: italic;
    color: var(--dim);
    margin: 0 0 1.3em;
  }

  .prose :global(a) {
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    color: var(--accent);
  }

  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.85em;
    background: rgba(232, 228, 220, 0.08);
    padding: 0.15em 0.4em;
    border-radius: 3px;
  }

  .prose :global(pre) {
    background: #141416;
    border: 1px solid var(--hairline);
    border-radius: 4px;
    padding: 1rem 1.2rem;
    overflow-x: auto;
    margin-bottom: 1.3em;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--hairline);
    margin: 2.5em 0;
  }
</style>
