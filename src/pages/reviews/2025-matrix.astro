---
import Base from '../../layouts/Base.astro';
import MatrixReview from '../../components/MatrixReview.astro';

const activities = [
  // Top right — successful, increasing focus
  { label: 'Coding with LLMs', x: 9, y: 10, labelOffset: { x: 70, y: 0 } },
  { label: 'Reading Fiction', x: 5, y: 10, labelOffset: { x: 60, y: 0 } },
  { label: 'Prop Trading', x: 8, y: 8, labelOffset: { x: 55, y: 0 } },
  { label: 'Date Nights', x: 2, y: 9, labelOffset: { x: 55, y: 0 } },
  { label: 'Lifting', x: 6, y: 6, labelOffset: { x: 35, y: 0 } },
  { label: 'Hiking', x: 3, y: 7, labelOffset: { x: 35, y: 0 } },
  { label: 'Cold Plunges', x: 8, y: 5, labelOffset: { x: 55, y: 0 } },
  { label: 'Running', x: 9, y: 3, labelOffset: { x: 40, y: 0 } },
  { label: 'Patience', x: 1, y: 5, labelOffset: { x: 45, y: 0 } },
  { label: 'Counting Macros', x: 4, y: 4, labelOffset: { x: 60, y: 0 } },
  { label: 'Card Games', x: 1, y: 2, labelOffset: { x: 55, y: 0 } },
  // Top left — challenging but improving
  { label: 'Shakespeare', x: -2, y: 10, labelOffset: { x: -50, y: 0 } },
  { label: 'Shadow Work', x: -5, y: 8.5, labelOffset: { x: -55, y: 0 } },
  { label: 'Saul Goodman TV', x: -5, y: 7, labelOffset: { x: -70, y: 0 } },
  { label: 'Writing', x: -1, y: 4, labelOffset: { x: -40, y: 0 } },
  { label: 'Travel', x: -4, y: 3, labelOffset: { x: -35, y: 0 } },
  // Bottom left — challenging, reducing
  { label: 'Market Making', x: -4, y: -10, labelOffset: { x: -60, y: 0 } },
  { label: 'Meetings', x: -5, y: -9, labelOffset: { x: 45, y: 0 } },
  { label: 'Drinking Alcohol', x: -4, y: -8, labelOffset: { x: -70, y: 0 } },
  { label: 'Watching TV', x: -7, y: -7, labelOffset: { x: -55, y: 0 } },
  { label: 'Watching Sports', x: -1, y: -5, labelOffset: { x: 60, y: 0 } },
  // Bottom right — successful but decreasing
  { label: 'Doomscrolling', x: 6, y: -5, labelOffset: { x: 60, y: 0 } },
  { label: 'Calling Kids by Right Name', x: -5, y: 0, labelOffset: { x: -95, y: 0 } },
];
---
<Base title="2025 Matrix — Stephen Longo" description="2025 annual review: outcome vs. change in focus for 2026.">
  <header class="top">
    <a class="mono back" href="/reviews">← Annual Reviews</a>
    <span class="mono">004 / 2025 Matrix</span>
  </header>

  <main>
    <MatrixReview
      year="2025"
      xLabel="2025 Outcome"
      yLabel="Change in Focus for 2026"
      activities={activities}
    />
  </main>

  <footer class="bottom">
    <span class="mono">A year, reviewed</span>
    <span class="mono">© 2026</span>
  </footer>
</Base>

<style>
  .top,
  .bottom {
    display: flex;
    justify-content: space-between;
    padding: 1.4rem var(--pad-x);
  }

  .top {
    border-bottom: 1px solid var(--hairline);
  }

  .bottom {
    border-top: 1px solid var(--hairline);
  }

  .back {
    text-decoration: none;
    color: var(--ink);
  }

  .back:hover {
    color: var(--accent);
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--pad-x);
  }
</style>
