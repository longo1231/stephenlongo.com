---
import Base from '../layouts/Base.astro';
import data from '../data/misogi.json';

// Kill switch: set false to unpublish — /misogi builds as a noindex redirect
// to home and the page only renders in dev (see docs/MISOGI-SPEC.md).
const LIVE = true;
if (!LIVE && !import.meta.env.DEV) return Astro.redirect('/');

// Same title hash as the bookshelf, so the misogi spines share tints with
// their shelf counterparts.
const hue = (title) => {
  let n = 0;
  for (const c of title) n = (n * 31 + c.charCodeAt(0)) % 360;
  return n;
};

const glyph = { done: '●', now: '◐', up: '○' };
---
<Base title="Reading Misogi — Stephen Longo" description="One deliberately hard reading project a year: Karamazov, the Bible, Borges, Shakespeare. The method, not just the list.">
  <header class="top">
    <a class="mono back" href="/">← Stephen Longo</a>
    <span class="mono">Index — 005 / Misogi{!LIVE && ' · draft'}</span>
  </header>

  <main>
    <section class="head">
      <h1>Reading <em>Misogi</em></h1>
      <p class="intro">
        One deliberately oversized reading project a year — picked on purpose, structured
        daily, scaffolded shamelessly. A misogi is the one hard thing you do each year;
        this is the reading version. The point isn't having read it.
        <em>It's the year spent reading it.</em>
      </p>
    </section>

    <section class="arc" aria-label="The misogi arc, one per year">
      <div class="arc-shelf">
        {data.years.map((y) => (
          <a
            class:list={['asp', { pulled: y.spine.pulled }]}
            href={`#y${y.id}`}
            style={`--w:${y.spine.w}px;--h:${y.spine.h}px;--hue:${hue(y.title)}`}
          >
            <span class="asp-t" aria-hidden="true">{y.spine.label}</span>
            <span class="mono asp-y">{y.year}</span>
          </a>
        ))}
        <div class="asp ghost" style="--w:48px;--h:220px">
          <span class="asp-t" aria-hidden="true">{data.ghost.label}</span>
          <span class="mono asp-y">{data.ghost.year}</span>
        </div>
      </div>
      <p class="mono legend">One mountain a year · width = the size of the climb · {data.years.at(-1).year} is mid-climb</p>
    </section>

    {data.years.map((y) => (
      <article class="chapter" id={`y${y.id}`}>
        <p class="mono kicker">{y.kicker}</p>
        <h2>{y.title}</h2>
        <p class="why">{y.why}</p>

        <div class="protocol">
          <div class="prow">
            <span class="mono plabel">Cadence</span>
            <p>{y.protocol.cadence}</p>
          </div>
          <div class="prow">
            <span class="mono plabel">Route</span>
            <p>{y.protocol.route}</p>
          </div>
          <div class="prow">
            <span class="mono plabel">Scaffolding</span>
            <p>{y.protocol.scaffolding}</p>
          </div>
          <div class="prow">
            <span class="mono plabel">Rules</span>
            <p>{y.protocol.rules}</p>
          </div>
        </div>

        {y.gave && (
          <p class="gave"><span class="mono plabel">What it gave me</span> <em>“{y.gave}”</em></p>
        )}

        {y.id === '2026' && (
          <div class="route">
            <p class="mono route-head">The route · steal this syllabus</p>
            {data.route.map((m) => (
              <div class="month">
                <p class="mono month-h">{m.month} — {m.theme}</p>
                <ul>
                  {m.plays.map((p) => (
                    <li class:list={['play', p.status]}>
                      <span class="mono g" aria-hidden="true">{glyph[p.status]}</span>
                      <span class="pname">{p.name}</span>
                      <span class="pnote">{p.note}</span>
                      {p.verdict && <span class="pverdict">“{p.verdict}”</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <p class="mono route-key">● read · ◐ now · ○ ahead — verdicts appear as they're written</p>
          </div>
        )}
      </article>
    ))}

    <section class="own">
      <p class="mono kicker">Run your own</p>
      <ol>
        {data.principles.map((p, i) => (
          <li>
            <span class="mono num">{String(i + 1).padStart(2, '0')}</span>
            <p>{p}</p>
          </li>
        ))}
      </ol>
      <p class="own-close">The Shakespeare route above is a complete, tested syllabus. <em>Steal it.</em></p>
    </section>
  </main>

  <footer class="bottom">
    <span class="mono">One mountain a year</span>
    <span class="mono">© 2026</span>
  </footer>
</Base>

<style>
  .top,
  .bottom {
    display: flex;
    justify-content: space-between;
    padding: 1.4rem var(--pad-x);
  }

  .top {
    border-bottom: 1px solid var(--hairline);
  }

  .bottom {
    border-top: 1px solid var(--hairline);
  }

  .back {
    text-decoration: none;
    color: var(--ink);
  }

  .back:hover {
    color: var(--accent);
  }

  main {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 var(--pad-x);
  }

  .head {
    padding: 5rem 0 1rem;
  }

  h1 {
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 560;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  h1 em {
    font-style: italic;
    font-weight: 380;
    color: var(--accent);
  }

  .intro {
    margin-top: 1.6rem;
    max-width: 56ch;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--ink);
  }

  .intro em {
    color: var(--accent);
    font-style: italic;
  }

  /* --- The arc: four spines + a ghost --- */

  .arc {
    padding: 3.5rem 0 4.5rem;
  }

  .arc-shelf {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    border-bottom: 3px solid var(--hairline);
    padding: 1.2rem 6px 0;
  }

  .asp {
    position: relative;
    flex: 0 0 auto;
    width: var(--w);
    height: var(--h);
    background: linear-gradient(180deg, hsl(var(--hue) 32% 20%), hsl(var(--hue) 40% 10%));
    border: 1px solid hsl(var(--hue) 30% 28% / 0.6);
    border-bottom: none;
    border-radius: 3px 3px 0 0;
    text-decoration: none;
    transition: transform 0.18s ease;
  }

  .asp:hover {
    transform: translateY(-10px);
  }

  .asp.pulled {
    transform: translateY(-16px) rotate(-4deg);
    transform-origin: bottom center;
    border-top: 3px solid var(--accent);
  }

  .asp.pulled:hover {
    transform: translateY(-24px) rotate(-4deg);
  }

  .asp.ghost {
    background: none;
    border: 1px dashed var(--hairline);
    border-bottom: none;
  }

  .asp-t {
    display: block;
    margin: 0 auto;
    writing-mode: vertical-rl;
    font-family: var(--serif);
    font-weight: 520;
    font-size: 0.82rem;
    line-height: 1;
    letter-spacing: 0.03em;
    color: var(--ink);
    opacity: 0.95;
    padding-top: 0.9rem;
    max-height: calc(var(--h) - 1.8rem);
    overflow: hidden;
    white-space: nowrap;
  }

  .ghost .asp-t {
    color: var(--dim);
    font-style: italic;
  }

  .asp-y {
    position: absolute;
    left: 50%;
    bottom: -1.9rem;
    transform: translateX(-50%);
  }

  /* The pulled spine is translated and rotated; undo both so its year label
     sits level on the baseline with the others. */
  .asp.pulled .asp-y {
    bottom: calc(-1.9rem - 16px);
    transform: translateX(-50%) rotate(4deg);
  }

  .legend {
    margin-top: 3rem;
  }

  /* --- Chapters --- */

  .chapter {
    padding: 3.2rem 0 1rem;
    border-top: 1px solid var(--hairline);
    scroll-margin-top: 2rem;
  }

  .kicker {
    color: var(--accent);
  }

  h2 {
    margin-top: 0.7rem;
    font-size: 2rem;
    font-weight: 520;
    line-height: 1.1;
  }

  .why {
    margin-top: 0.9rem;
    max-width: 60ch;
    line-height: 1.55;
    color: var(--ink);
  }

  .protocol {
    margin-top: 1.6rem;
    border: 1px solid var(--hairline);
    border-radius: 4px;
  }

  .prow {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
  }

  .prow + .prow {
    border-top: 1px solid var(--hairline);
  }

  .prow p {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink);
  }

  .plabel {
    padding-top: 0.15rem;
  }

  .gave {
    margin-top: 1.3rem;
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1rem;
    padding: 0 1.1rem;
  }

  .gave em {
    font-size: 1.02rem;
    line-height: 1.5;
  }

  /* --- The Shakespeare route --- */

  .route {
    margin-top: 2.2rem;
  }

  .route-head {
    color: var(--accent);
    padding-bottom: 0.6rem;
  }

  .month {
    padding: 0.9rem 0;
    border-top: 1px solid var(--hairline);
  }

  .month-h {
    padding-bottom: 0.5rem;
  }

  .month ul {
    list-style: none;
  }

  .play {
    display: grid;
    grid-template-columns: 1.4rem minmax(11rem, auto) 1fr;
    gap: 0.4rem 0.8rem;
    padding: 0.28rem 0;
    align-items: baseline;
  }

  .g {
    color: var(--dim);
  }

  .play.now .g,
  .play.now .pname {
    color: var(--accent);
  }

  .pname {
    font-weight: 520;
    font-size: 0.98rem;
  }

  .play.up .pname {
    color: var(--dim);
  }

  .pnote {
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--dim);
  }

  .pverdict {
    grid-column: 3;
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--ink);
  }

  .route-key {
    padding-top: 1rem;
  }

  /* --- Run your own --- */

  .own {
    margin-top: 3rem;
    padding: 3.2rem 0 5rem;
    border-top: 1px solid var(--hairline);
  }

  .own ol {
    list-style: none;
    margin-top: 1.4rem;
    max-width: 60ch;
  }

  .own li {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 0.9rem;
    padding: 0.55rem 0;
  }

  .num {
    color: var(--accent);
    padding-top: 0.2rem;
  }

  .own li p {
    line-height: 1.5;
  }

  .own-close {
    margin-top: 1.8rem;
    font-size: 1.05rem;
  }

  .own-close em {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .arc-shelf {
      gap: 9px;
    }

    .asp {
      width: calc(var(--w) * 0.78);
      height: calc(var(--h) * 0.85);
    }

    .prow,
    .gave {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .play {
      grid-template-columns: 1.4rem 1fr;
    }

    .pnote,
    .pverdict {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .asp {
      transition: none;
    }
  }
</style>
