---
// Spine Wall v2 — the bookshelf as a real bookcase (see docs/SPINE-WALL-SPEC.md).
// Spines wrap into shelves; width encodes page count, five-stars lean out, and
// clicking a spine pulls the book off the shelf into a centered modal.
const { books } = Astro.props;

// Same title hash as the cover grid, so both views share tints.
const hue = (title) => {
  let n = 0;
  for (const c of title) n = (n * 31 + c.charCodeAt(0)) % 360;
  return n;
};

// Deterministic per-title jitter so the shelf looks organic but never shifts between builds.
const jitter = (title) => {
  let n = 0;
  for (const c of title) n = (n * 37 + c.charCodeAt(0)) % 997;
  return n;
};

const paged = books
  .map((b) => b.pages)
  .filter(Boolean)
  .sort((a, b) => a - b);
const median = paged[Math.floor(paged.length / 2)] ?? 300;

const width = (pages) => Math.round(Math.min(44, Math.max(14, 14 + ((pages - 120) / 900) * 30)));
const height = (title) => 170 + (jitter(title) % 61);
const year = (d) => (d ? d.slice(0, 4) : '');

const pullData = books.map((b) => ({
  t: b.title,
  a: b.author || 'Unknown',
  p: b.pages,
  r: b.rating,
  n: b.takeaway || b.tagline || '',
  c: b.cover,
  rec: b.recommend ? 1 : 0,
  y: year(b.date),
  h: hue(b.title),
  now: b.status === 'Reading' ? 1 : 0,
}));
---
<section class="wall active" id="spine-wall">
  <p class="mono detail" id="spine-detail" aria-live="polite">Click a spine to pull it off the shelf</p>

  <div class="case">
    {books.map((b, i) => (
      <div class:list={['slot', { lean: b.rating === 5 }]}>
        <button
          class:list={['sp', { lean: b.rating === 5 }]}
          style={`--w:${width(b.pages ?? median)}px;--h:${height(b.title)}px;--hue:${hue(b.title)};--lean:${b.rating === 5 ? (i % 2 ? -6 : -4) : 0}deg`}
          data-i={i}
          data-rating={b.rating ?? ''}
          data-type={b.type ?? ''}
          data-recommend={b.recommend ? '1' : ''}
          aria-label={`${b.title} by ${b.author || 'unknown'}${b.pages ? `, ${b.pages} pages` : ''}${b.rating ? `, ${b.rating} stars` : ''}`}
        >
          <span class="sp-t" aria-hidden="true">{b.title}</span>
        </button>
      </div>
    ))}
  </div>

  <p class="mono legend">Width = page count · Leaning spines = five stars</p>

  <div class="pull-wrap" id="spine-pull" hidden>
    <div class="pull" role="dialog" aria-modal="true" aria-labelledby="pull-title">
      <div class="pull-jacket" id="pull-jacket"></div>
      <div class="pull-info">
        <h2 id="pull-title"></h2>
        <p class="mono pull-meta" id="pull-meta"></p>
        <p class="pull-rating" id="pull-rating"></p>
        <p class="pull-note" id="pull-note"></p>
        <p class="mono pull-rec" id="pull-rec" hidden>Recommended</p>
      </div>
      <button class="mono pull-close" id="pull-close" aria-label="Put the book back">✕</button>
    </div>
  </div>
</section>
<script type="application/json" id="spine-data" set:html={JSON.stringify(pullData)}></script>

<style>
  .wall {
    display: none;
    padding-bottom: 8rem;
  }

  .wall.active {
    display: block;
  }

  .detail {
    padding-bottom: 1.6rem;
    min-height: 1.1em;
  }

  .detail.on {
    color: var(--ink);
  }

  .case {
    display: flex;
    flex-wrap: wrap;
    row-gap: 2.6rem;
    padding-top: 1rem;
  }

  /* Each book sits in a fixed-height slot whose bottom border fuses with its
     neighbours' into a continuous shelf line per wrapped row — the line ends
     where the books end on the last, partly filled shelf. */
  .slot {
    height: 240px;
    display: flex;
    align-items: flex-end;
    border-bottom: 3px solid var(--hairline);
    padding: 0 1.5px;
  }

  /* Breathing room for the lean via padding, not margin — the border spans
     the padding box, so the shelf line stays unbroken. */
  .slot.lean {
    padding-left: 0.5rem;
  }

  .sp {
    flex: 0 0 auto;
    width: var(--w);
    height: var(--h);
    padding: 0;
    background: linear-gradient(180deg, hsl(var(--hue) 32% 18%), hsl(var(--hue) 40% 9%));
    border: 1px solid hsl(var(--hue) 30% 26% / 0.6);
    border-bottom: none;
    border-radius: 2px 2px 0 0;
    overflow: hidden;
    cursor: pointer;
    transform: rotate(var(--lean));
    transform-origin: bottom center;
    transition: transform 0.18s ease, opacity 0.25s ease;
  }

  .sp.lean {
    border-top: 3px solid var(--accent);
  }

  .sp:hover,
  .sp:focus-visible,
  .sp.pulled {
    transform: translateY(-14px) rotate(var(--lean));
  }

  .sp:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 2px;
  }

  .sp.dim {
    opacity: 0.12;
  }

  .sp-t {
    display: block;
    margin: 0 auto;
    writing-mode: vertical-rl;
    font-family: var(--serif);
    font-weight: 520;
    font-size: 0.74rem;
    line-height: 1;
    letter-spacing: 0.03em;
    color: var(--ink);
    opacity: 0.95;
    padding-top: 0.7rem;
    max-height: calc(var(--h) - 1.4rem);
    overflow: hidden;
    white-space: nowrap;
  }

  .legend {
    margin-top: 1.2rem;
  }

  .pull-wrap {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(8, 8, 9, 0.7);
  }

  .pull-wrap[hidden] {
    display: none;
  }

  .pull {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1.6rem;
    width: min(560px, 100%);
    max-height: 85vh;
    overflow: auto;
    padding: 1.4rem;
    border: 1px solid var(--hairline);
    border-radius: 4px;
    background: var(--bg);
    animation: sw-pull 0.3s ease;
  }

  @keyframes sw-pull {
    from {
      transform: scale(0.94);
      opacity: 0;
    }
  }

  .pull-jacket {
    flex: 0 0 180px;
    aspect-ratio: 2 / 3;
    border-radius: 3px;
    overflow: hidden;
    background: #141416;
    transform-origin: left center;
    animation: sw-flip 0.35s ease;
  }

  .pull-jacket :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pull-jacket :global(.pull-tint) {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.9rem;
    background: linear-gradient(160deg, hsl(var(--hue) 32% 16%), hsl(var(--hue) 40% 8%));
    border: 1px solid hsl(var(--hue) 30% 24% / 0.6);
    border-radius: 3px;
  }

  .pull-jacket :global(.tint-t) {
    font-style: italic;
    font-size: 1rem;
    line-height: 1.15;
  }

  @keyframes sw-flip {
    from {
      transform: perspective(700px) rotateY(80deg);
    }
  }

  .pull-info h2 {
    font-size: 1.35rem;
    font-weight: 480;
    line-height: 1.15;
  }

  .pull-meta {
    margin-top: 0.45rem;
  }

  .pull-rating {
    margin-top: 0.8rem;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .pull-rating :global(.off) {
    color: var(--hairline);
  }

  .pull-note {
    margin-top: 0.8rem;
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .pull-rec {
    margin-top: 0.8rem;
    color: var(--accent);
  }

  .pull-close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    background: none;
    border: none;
    cursor: pointer;
  }

  .pull-close:hover {
    color: var(--ink);
  }

  @media (max-width: 560px) {
    .pull {
      flex-direction: column;
    }

    .pull-jacket {
      flex-basis: auto;
      width: 150px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sp {
      transition: none;
    }

    .pull,
    .pull-jacket {
      animation: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const wall = document.getElementById('spine-wall');
    if (!wall) return;
    const data = JSON.parse(document.getElementById('spine-data').textContent);
    const spines = wall.querySelectorAll('.sp');
    const detail = document.getElementById('spine-detail');
    const wrap = document.getElementById('spine-pull');
    const jacket = document.getElementById('pull-jacket');
    const pullTitle = document.getElementById('pull-title');
    const pullMeta = document.getElementById('pull-meta');
    const pullRating = document.getElementById('pull-rating');
    const pullNote = document.getElementById('pull-note');
    const pullRec = document.getElementById('pull-rec');
    const closeBtn = document.getElementById('pull-close');

    const esc = (s) =>
      String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
    const stars = (r) => '★'.repeat(r) + `<span class="off">${'★'.repeat(5 - r)}</span>`;
    const line = (b) =>
      `${b.t} — ${b.a}${b.p ? ` · ${b.p.toLocaleString()} pages` : ''}${b.r ? ` · ${'★'.repeat(b.r)}` : ''}`;

    let open = -1;
    let lastSpine = null;
    const close = () => {
      if (open < 0) return;
      open = -1;
      wrap.hidden = true;
      document.body.style.overflow = '';
      spines.forEach((s) => s.classList.remove('pulled'));
      if (lastSpine) lastSpine.focus();
      lastSpine = null;
    };

    const openBook = (i, spine) => {
      const b = data[i];
      open = i;
      spine.classList.add('pulled');
      jacket.innerHTML = b.c
        ? `<img src="${esc(b.c)}" alt="Cover of ${esc(b.t)}" loading="lazy">`
        : `<div class="pull-tint" style="--hue:${b.h}"><span class="tint-t">${esc(b.t)}</span><span class="mono">${esc(b.a)}</span></div>`;
      pullTitle.textContent = b.t;
      pullMeta.textContent = `${b.a}${b.y ? ` · ${b.y}` : ''}${b.now ? ' · now reading' : ''}`;
      pullRating.innerHTML = b.r ? stars(b.r) : '';
      pullNote.textContent = b.n ? `“${b.n}”` : '';
      pullRec.hidden = !b.rec;
      wrap.hidden = false;
      document.body.style.overflow = 'hidden';
      lastSpine = spine;
      closeBtn.focus();
    };

    spines.forEach((s) => {
      const i = +s.dataset.i;
      const show = () => {
        detail.textContent = line(data[i]);
        detail.classList.add('on');
      };
      s.addEventListener('mouseenter', show);
      s.addEventListener('focus', show);
      s.addEventListener('click', () => openBook(i, s));
    });

    closeBtn.addEventListener('click', close);
    wrap.addEventListener('click', (e) => {
      if (e.target === wrap) close();
    });
    document.addEventListener('keydown', (e) => {
      if (open < 0) return;
      if (e.key === 'Escape') close();
      // The dialog's only focusable element is ✕ — keep Tab from escaping it.
      if (e.key === 'Tab') {
        e.preventDefault();
        closeBtn.focus();
      }
    });
  })();
</script>
